---
/** Lucide arrow icons used across the site. */
interface Props {
  name: 'arrow-up-right' | 'arrow-left' | 'arrow-right';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  'arrow-up-right': ['M7 7h10v10', 'M7 17 17 7'],
  'arrow-left': ['m12 19-7-7 7-7', 'M19 12H5'],
  'arrow-right': ['M5 12h14', 'm12 5 7 7-7 7'],
}[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {paths.map((d) => <path d={d} />)}
</svg>
