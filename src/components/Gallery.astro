---
/**
 * Project images. Phone screenshots (portrait raster images) sit behind an
 * "Open gallery" button; diagrams and landscape images stay inline as a grid.
 * Both open in the same lightbox, each set browsed on its own.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { langFromPath, t } from '../i18n';

interface Props {
  items: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { items } = Astro.props;
const T = t(langFromPath(Astro.url.pathname)).project;

const isSvg = (m: ImageMetadata) => m.format === 'svg';
const isPortrait = (m: ImageMetadata) => !isSvg(m) && m.height > m.width;
const prepared = await Promise.all(
  items.map(async (it) => {
    const portrait = isPortrait(it.src);
    if (isSvg(it.src)) return { ...it, portrait, thumb: it.src.src, full: it.src.src };
    const thumb = await getImage({ src: it.src, width: 720, format: 'webp' });
    const full = await getImage({ src: it.src, width: portrait ? 1080 : 1800, format: 'webp' });
    return { ...it, portrait, thumb: thumb.src, full: full.src };
  }),
);
const screens = prepared.filter((it) => it.portrait);
const figures = prepared.filter((it) => !it.portrait);
const onlyDiagrams = figures.every((it) => isSvg(it.src));
---

{
  screens.length > 0 && (
    <section class="screens-entry mt-14" aria-labelledby="screens-title" data-reveal>
      <div>
        <h2 id="screens-title" class="label">{T.screens}</h2>
        <p class="mt-2 max-w-38 text-14_5 leading-relaxed text-white-60">{T.screensText(screens.length)}</p>
      </div>
      <button class="btn btn-line" type="button" data-gallery-open="screens">
        {T.openGallery} <span class="font-mono text-white-45">{screens.length}</span>
        <Icon name="arrow-right" class="icon-sm" />
      </button>
      {screens.map((it) => (
        <span
          hidden
          data-gallery-item
          data-gallery-set="screens"
          data-portrait
          data-full={it.full}
          data-alt={it.alt}
          data-caption={it.caption ?? ''}
        />
      ))}
    </section>
  )
}

{
  figures.length > 0 && (
    <section class="mt-14" aria-labelledby="gallery-title">
      <h2 id="gallery-title" class="label">
        {onlyDiagrams ? T.diagrams : T.gallery}
      </h2>
      <p class="mt-2 text-12_5 text-white-40">{T.enlargeHint}</p>
      <div class="gallery mt-5" data-stagger>
        {figures.map((it) => (
          <figure style="margin:0">
            <button
              type="button"
              data-gallery-item
              data-gallery-set="figures"
              data-full={it.full}
              data-alt={it.alt}
              data-caption={it.caption ?? ''}
              aria-label={T.enlarge(it.alt)}
            >
              <img src={it.thumb} alt={it.alt} loading="lazy" decoding="async" />
              {it.caption && <figcaption>{it.caption}</figcaption>}
            </button>
          </figure>
        ))}
      </div>
    </section>
  )
}

{
  prepared.length > 0 && (
    <dialog class="lightbox" data-lightbox aria-label={T.viewer}>
      <img src="" alt="" />
      <div class="lightbox-bar">
        <p data-lightbox-caption />
        <div class="flex items-center gap-2">
          <span class="font-mono text-11 text-white-45" data-lightbox-count />
          <button class="icon-btn" type="button" data-lightbox-prev aria-label={T.prev}>
            ‹
          </button>
          <button class="icon-btn" type="button" data-lightbox-next aria-label={T.nextImage}>
            ›
          </button>
          <button class="icon-btn" type="button" data-lightbox-close aria-label={T.close}>
            ✕
          </button>
        </div>
      </div>
    </dialog>
  )
}
