---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { LAYERS } from '../../content.config';
import { SITE, LAYER_INFO } from '../../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const topDown = [...LAYERS].reverse();
---

<Base title={`Work — ${SITE.name}`} description="Every project, grouped by the layer of the stack it lives in.">
  <main>
    <section class="site-wrap pt-20 pb-14 md-pt-24">
      <div data-reveal>
        <span class="tag-accent">{projects.length} projects</span>
        <h1 class="mt-5 max-w-3xl font-display text-h1 font-medium leading-105 tracking-tight">Work, layer by layer</h1>
        <p class="mt-5 max-w-2xl text-17 leading-relaxed text-white-70">
          From Android apps down to an operating system kernel. Each project has its own page with the problem, the
          architecture and what was hard about it.
        </p>
      </div>
      <nav class="tabs mt-10" aria-label="Jump to layer">
        {topDown.map((l) => <a href={`#${l}`}>{LAYER_INFO[l].addr} {LAYER_INFO[l].name}</a>)}
      </nav>
    </section>

    {
      topDown.map((layer) => (
        <section
          id={layer}
          class="anchor border-t border-white-10 py-20"
          style={`background-color:${LAYER_INFO[layer].bg}`}
          aria-labelledby={`h-${layer}`}
        >
          <div class="site-wrap">
            <div class="flex flex-wrap items-baseline justify-between gap-4" data-reveal>
              <div class="border-l-2 pl-4" style="border-color:#ff4f00">
                <p class="font-mono text-10 uppercase tracking-20 text-white-35">{LAYER_INFO[layer].addr}</p>
                <h2 id={`h-${layer}`} class="mt-1_5 font-display text-15 uppercase tracking-12 text-f2">
                  {LAYER_INFO[layer].name}
                </h2>
              </div>
              <p class="text-15 text-white-55">{LAYER_INFO[layer].blurb}</p>
            </div>
            <div class="grid-cards cols-3 mt-10" data-stagger>
              {projects
                .filter((p) => p.data.layer === layer)
                .map((p) => (
                  <ProjectCard project={p} maxTags={3} />
                ))}
            </div>
          </div>
        </section>
      ))
    }
  </main>
</Base>
