---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SITE, LAYER_INFO } from '../../site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { title, summary, layer, stack, team, context, status, repo } = project.data;
const { Content } = await render(project);

const facts = [
  ['Layer', LAYER_INFO[layer].name],
  ['Context', context],
  ...(team ? [['Team', team]] : []),
  ['Status', status === 'in-progress' ? 'In progress' : 'Complete'],
];
---

<Base title={`${title} — ${SITE.name}`} description={summary}>
  <main class="site-wrap py-12 md-py-20">
    <a
      class="inline-flex items-center gap-2 font-mono text-10 uppercase tracking-16 text-white-45 transition-colors hover-text-accent"
      href="/#work"
    >
      <Icon name="arrow-left" class="icon-sm" />All projects
    </a>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <span class="tag-accent">{LAYER_INFO[layer].name} layer</span>
      {status === 'in-progress' && <span class="wip">in progress</span>}
    </div>
    <h1 class="mt-5 max-w-3xl font-display text-h1 font-medium leading-105 tracking-tight">{title}</h1>
    <p class="mt-5 max-w-2xl text-17 leading-relaxed text-white-70">{summary}</p>

    <div class="mt-14 grid gap-10 border-t border-white-10 pt-10 md-cols-250-1 md-gap-16">
      <aside class="md-sticky md-top-24 md-self-start">
        <dl class="space-y-4">
          {
            facts.map(([k, v]) => (
              <div class="border-t border-white-10 pt-3">
                <dt class="font-mono text-10 uppercase tracking-18 text-white-35">{k}</dt>
                <dd class="mt-1_5 font-mono text-12_5 leading-relaxed text-f2">{v}</dd>
              </div>
            ))
          }
          <div class="border-t border-white-10 pt-3">
            <dt class="font-mono text-10 uppercase tracking-18 text-white-35">Built with</dt>
            <dd class="mt-2_5 flex flex-wrap gap-1_5">
              {stack.map((s) => <span class="tech">{s}</span>)}
            </dd>
          </div>
        </dl>
        {
          repo && (
            <a
              href={repo}
              target="_blank"
              rel="noreferrer"
              class="mt-7 inline-flex border border-accent-70 px-4 py-2_5 font-mono text-10 uppercase tracking-16 text-accent transition-colors hover-bg-accent hover-text-0a"
            >
              View source code
            </a>
          )
        }
      </aside>
      <div class="max-w-38">
        <div class="prose-tech">
          <Content />
        </div>
      </div>
    </div>

    <a class="group mt-16 flex items-center justify-between gap-6 border-t border-white-10 pt-8" href={`/projects/${next.id}/`}>
      <span>
        <span class="label">Next project</span>
        <span class="mt-2 block font-display text-next font-medium tracking-tight transition-colors group-hover-text-accent">
          {next.data.title}
        </span>
      </span>
      <Icon name="arrow-right" class="icon-md text-white-40 transition-all group-hover-nudge group-hover-text-ff4f00" />
    </a>
  </main>
</Base>
