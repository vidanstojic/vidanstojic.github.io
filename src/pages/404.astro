---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { UI } from '../i18n';

// GitHub Pages serves this one file for every missing address, English or
// Serbian, so both texts are in the page and the script picks one by the URL.
const en = UI.en.notFound;
const sr = UI.sr.notFound;
---

<Base title={en.title} noindex>
  <main class="site-wrap py-20">
    <span class="tag-accent">404</span>
    <h1 class="mt-5 max-w-3xl font-display text-h1 font-medium leading-105 tracking-tight" data-nf="heading" data-sr={sr.heading}>
      {en.heading}
    </h1>
    <p class="mt-5 max-w-2xl text-17 leading-relaxed text-white-70" data-nf="text" data-sr={sr.text}>{en.text}</p>
    <a
      class="mt-9 inline-flex items-center gap-2 font-mono text-10 uppercase tracking-16 text-accent transition-colors hover-text-f2"
      href="/projects/"
      data-nf-link
    >
      <Icon name="arrow-left" class="icon-sm" /><span data-nf="back" data-sr={sr.back}>{en.back}</span>
    </a>
  </main>
  <script is:inline src="/scripts/not-found.js" data-sr-title={sr.title}></script>
</Base>
