---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found — Vidan Stojić">
  <main class="site-wrap py-20">
    <span class="tag-accent">404</span>
    <h1 class="mt-5 max-w-3xl font-display text-h1 font-medium leading-105 tracking-tight">This page doesn't exist.</h1>
    <p class="mt-5 max-w-2xl text-17 leading-relaxed text-white-70">The link may be old or mistyped.</p>
    <a
      class="mt-9 inline-flex items-center gap-2 font-mono text-10 uppercase tracking-16 text-accent transition-colors hover-text-f2"
      href="/#work"
    >
      <Icon name="arrow-left" class="icon-sm" />Back to all projects
    </a>
  </main>
</Base>
