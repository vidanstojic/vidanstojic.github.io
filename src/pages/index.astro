---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LayerBands from '../components/LayerBands.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);

const headline = 'I build software from the kernel to the screen.';
const words = headline.split(' ');
---

<Base>
  <main>
    <section class="hs7-section" aria-label="Introduction">
      <div class="hs7-bg" aria-hidden="true">
        <img src="/images/hero-strata.webp" alt="" width="1280" height="720" fetchpriority="high" />
      </div>
      <div class="hs7-content">
        <p class="hs7-eyebrow"><span class="hs7-dot" aria-hidden="true"></span>Open to graduate and junior roles</p>
        <h1 class="hs7-title" aria-label={headline}>
          {
            words.map((w, i) => (
              <span aria-hidden="true">
                <span class="hs7-word">
                  {[...w].map((ch) => (
                    <span class="hs7-ltr">{ch}</span>
                  ))}
                </span>
                {i < words.length - 1 ? ' ' : ''}
              </span>
            ))
          }
        </h1>
        <p class="hs7-body">
          I'm Vidan, a final-year software engineering student at the School of Computing (RAF) in Belgrade. Most of my
          work is Android apps and backend services, and I've also written a compiler and changed an operating system
          kernel to understand what sits underneath them.
        </p>
        <a class="hs7-cta" href="#work">Read the work</a>
      </div>
    </section>

    <section id="work" class="anchor border-t border-white-10">
      <div class="site-wrap pb-14 pt-20 md-pt-24">
        <div class="grid gap-5 md-cols-1-1 md-items-end" data-reveal>
          <h2 class="sec-title">Work, layer by layer</h2>
          <p class="text-15 leading-relaxed text-white-55 md-text-right">
            Every project sits on the layer of the stack it lives in, from the apps people touch down to the kernel.
          </p>
        </div>
      </div>
      <LayerBands projects={projects} />
    </section>

    <section class="anchor border-t border-white-10 bg-0a py-20">
      <div class="site-wrap">
        <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
          <h2 class="sec-title">Selected projects</h2>
          <a class="link-line font-mono text-11 uppercase tracking-14 text-white-60 hover-text-f2" href="/projects/">
            All {projects.length} projects
          </a>
        </div>
        <div class="grid-cards mt-10" data-stagger>
          {featured.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>

    <section class="border-t border-white-10 bg-08 py-20">
      <div class="site-wrap">
        <div class="cta-band grid gap-6 md-cols-1-1 md-items-end" data-reveal>
          <div>
            <p class="hs7-eyebrow" style="animation:none;margin-bottom:1rem">
              <span class="hs7-dot" aria-hidden="true"></span>Open to graduate and junior roles
            </p>
            <h2 class="sec-title">Building something where the details matter?</h2>
            <p class="mt-4 text-15 leading-relaxed text-white-70">
              I'd like to hear about it. Tell me about the role or the project, and I'll get back to you.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 md-justify-end">
            <a class="btn btn-solid" href="/contact/">Get in touch <Icon name="arrow-right" class="icon-sm" /></a>
            <a class="btn btn-ghost" href="/about/">More about me</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
