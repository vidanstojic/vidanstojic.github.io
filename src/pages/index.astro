---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { LAYERS } from '../content.config';
import { SITE, LAYER_INFO } from '../site';
import hero from '../assets/hero-strata.webp';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const topDown = [...LAYERS].reverse();

const headline = 'I build software from the kernel to the screen.';
const words = headline.split(' ');

const toolkit = [
  { group: 'Languages', items: ['Kotlin', 'Java', 'C', 'C++', 'C#', 'Python', 'TypeScript'] },
  { group: 'Android', items: ['Jetpack Compose', 'Room', 'Hilt', 'WorkManager', 'Coroutines'] },
  { group: 'Backend', items: ['Spring Boot', 'Ktor', 'PostgreSQL', 'RabbitMQ', 'WebSocket', 'Docker'] },
  { group: 'Web and desktop', items: ['Angular', 'JavaFX'] },
  { group: 'Systems', items: ['xv6', 'Linux', 'ANTLR', 'Git'] },
];

const contacts = [
  SITE.email && { k: 'Email', v: SITE.email, href: `mailto:${SITE.email}`, ext: false },
  SITE.linkedin && { k: 'LinkedIn', v: SITE.linkedinHandle, href: SITE.linkedin, ext: true },
  { k: 'GitHub', v: SITE.githubHandle, href: SITE.github, ext: true },
  SITE.cv
    ? { k: 'CV', v: 'Download PDF', href: SITE.cv, ext: false }
    : SITE.email && { k: 'CV', v: 'PDF on request', href: `mailto:${SITE.email}?subject=CV%20request`, ext: false },
].filter(Boolean) as { k: string; v: string; href: string; ext: boolean }[];
---

<Base>
  <main>
    <section class="hs7-section" aria-label="Introduction">
      <div class="hs7-bg" aria-hidden="true">
        <Image src={hero} alt="" widths={[640, 1280]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="hs7-content">
        <p class="hs7-eyebrow"><span class="hs7-dot" aria-hidden="true"></span>Open to graduate and junior roles</p>
        <h1 class="hs7-title" aria-label={headline}>
          {
            words.map((w, i) => (
              <span aria-hidden="true">
                <span class="hs7-word">
                  {[...w].map((ch) => (
                    <span class="hs7-ltr">{ch}</span>
                  ))}
                </span>
                {i < words.length - 1 ? ' ' : ''}
              </span>
            ))
          }
        </h1>
        <p class="hs7-body">
          I'm Vidan, a final-year software engineering student at the School of Computing (RAF) in Belgrade. Most of my
          work is Android apps and backend services, and I've also written a compiler and changed an operating system
          kernel to understand what sits underneath them.
        </p>
        <a class="hs7-cta" href="/#work">Read the work</a>
      </div>
    </section>

    <section id="work" class="anchor border-t border-white-10">
      <div class="site-wrap pb-14 pt-20 md-pt-24">
        <div class="grid gap-5 md-cols-1-1 md-items-end">
          <h2 class="font-display text-h2 font-medium leading-tight tracking-tight">Work, layer by layer</h2>
          <p class="text-15 leading-relaxed text-white-55 md-text-right">
            Every project sits on the layer of the stack it lives in. The five written up in full are brighter; the rest
            are links.
          </p>
        </div>
      </div>
      <ol aria-label="Projects by layer, from interface down to kernel">
        {
          topDown.map((layer, i) => (
            <li
              id={layer}
              data-layer={layer}
              style={`background-color:${LAYER_INFO[layer].bg}`}
              class="anchor border-t border-white-10"
            >
              <div class="site-wrap grid gap-5 py-9 md-cols-200-1 md-gap-10">
                <div
                  class="layer-marker border-l-2 pl-4 transition-colors duration-300"
                  style={`border-color:${i === 0 ? '#ff4f00' : 'rgba(255,255,255,0.12)'}`}
                >
                  <p class="font-mono text-10 uppercase tracking-20 text-white-35">{LAYER_INFO[layer].addr}</p>
                  <h3 class="mt-1_5 font-display text-15 uppercase tracking-12 text-f2">{LAYER_INFO[layer].name}</h3>
                  <p class="mt-1_5 text-12_5 leading-snug text-white-40">{LAYER_INFO[layer].blurb}</p>
                </div>
                <ul class="divide-y divide-white-07">
                  {projects
                    .filter((p) => p.data.layer === layer)
                    .map((p) => (
                      <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1_5 py-2_5">
                        <a
                          class:list={[
                            'group inline-flex items-baseline gap-1_5 font-mono text-14_5 transition-colors hover-text-accent',
                            p.data.featured ? 'text-f2' : 'text-white-50',
                          ]}
                          href={`/projects/${p.id}/`}
                        >
                          {p.data.title}
                          <Icon
                            name="arrow-up-right"
                            class="icon-sm -translate-x-1 opacity-0 transition-all group-hover-show"
                          />
                        </a>
                        {p.data.status === 'in-progress' && <span class="wip">in progress</span>}
                        <span class="hidden lg-inline text-12_5 text-white-30">{p.data.context}</span>
                      </li>
                    ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="anchor border-t border-white-10 bg-0a py-20">
      <div class="site-wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="font-display text-h2 font-medium leading-tight tracking-tight">Selected projects</h2>
          <p class="label">{featured.length} of {projects.length}</p>
        </div>
        <div class="mt-10 divide-y divide-white-10 border-t border-white-10">
          {
            featured.map((p) => (
              <article class="group grid gap-5 py-9 md-cols-09-11 md-gap-12">
                <div>
                  <p class="label">
                    {LAYER_INFO[p.data.layer].name} layer · {p.data.context}
                  </p>
                  <h3 class="mt-3 font-display text-h3 font-medium leading-tight tracking-tight">
                    <a class="transition-colors hover-text-accent" href={`/projects/${p.id}/`}>
                      {p.data.title}
                    </a>
                  </h3>
                  {p.data.status === 'in-progress' && <span class="wip mt-3">in progress</span>}
                </div>
                <div>
                  <p class="text-15 leading-relaxed text-white-70">{p.data.summary}</p>
                  <ul class="mt-5 flex flex-wrap gap-1_5" aria-label="Technologies">
                    {p.data.stack.map((s) => (
                      <li>
                        <span class="tech">{s}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-6 flex flex-wrap items-center gap-6 font-mono text-11 uppercase tracking-14">
                    <a class="link-line text-accent" href={`/projects/${p.id}/`}>
                      Read how it works
                    </a>
                    {p.data.repo && (
                      <a href={p.data.repo} target="_blank" rel="noreferrer" class="link-line text-white-50 hover-text-f2">
                        Source on GitHub
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="about" class="anchor border-t border-white-10 bg-08 py-20">
      <div class="site-wrap grid gap-12 md-cols-075-125 md-gap-16">
        <div>
          <h2 class="font-display text-h2 font-medium leading-tight tracking-tight">About</h2>
          <p class="label mt-4">School of Computing, Belgrade · final year</p>
        </div>
        <div>
          <p class="mb-5 text-16_5 leading-175 text-white-75">
            I like problems where the details matter: a state machine that has to stay consistent when the network
            drops, a day boundary that breaks statistics, a page table that two processes share. I try to keep the core
            logic plain and testable and push the framework code to the edges.
          </p>
          <p class="mb-5 text-16_5 leading-175 text-white-75">
            I also tutor C, C++, Java and C#, which keeps me honest about explaining why code works, not only that it
            does. Outside of code I follow the banking sector and train boxing and table tennis.
          </p>
          <div class="mt-10 grid gap-x-8 gap-y-7 border-t border-white-10 pt-8 sm-grid-cols-2 lg-grid-cols-3">
            {
              toolkit.map((t) => (
                <div>
                  <h3 class="font-mono text-10 uppercase tracking-18 text-accent">{t.group}</h3>
                  <ul class="mt-3 space-y-1">
                    {t.items.map((it) => (
                      <li class="font-mono text-12_5 text-white-60">{it}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="anchor border-t border-white-10 bg-05 py-20">
      <div class="site-wrap">
        <div class="grid gap-5 md-cols-1-1 md-items-end">
          <h2 class="font-display text-h2 font-medium leading-tight tracking-tight">Contact</h2>
          <p class="text-15 leading-relaxed text-white-55 md-text-right">
            I'm looking for a graduate or junior role. The fastest way to reach me:
          </p>
        </div>
        <ul class="mt-10 grid gap-3 sm-grid-cols-2 lg-grid-cols-4">
          {
            contacts.map((c) => (
              <li>
                <a
                  href={c.href}
                  target={c.ext ? '_blank' : undefined}
                  rel={c.ext ? 'noreferrer' : undefined}
                  class="group flex h-full flex-col justify-between gap-6 border border-white-15 p-5 transition-colors hover-border-accent hover-bg-white-02"
                >
                  <span class="font-mono text-10 uppercase tracking-18 text-white-40 group-hover-text-accent">{c.k}</span>
                  <span class="break-words font-mono text-13 text-f2">{c.v}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>

<script>
  // Highlight the layer band that sits in the middle of the viewport.
  const markers = new Map<Element, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-layer]').forEach((band) => {
    const m = band.querySelector<HTMLElement>('.layer-marker');
    if (m) markers.set(band, m);
  });
  const setActive = (active: Element) => {
    markers.forEach((m, band) => {
      m.style.borderColor = band === active ? '#ff4f00' : 'rgba(255,255,255,0.12)';
    });
  };
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target)),
    { rootMargin: '-45% 0px -55% 0px' },
  );
  markers.forEach((_, band) => io.observe(band));
</script>
