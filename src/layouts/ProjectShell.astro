---
/**
 * Shared frame for a project's overview page and its sub-pages:
 * header, links, tab navigation, facts sidebar, body slot, next project.
 */
import Base from './Base.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { SITE, LAYER_INFO } from '../site';
import { getProjects, getSubpages, type Project } from '../lib/projects';
import { langFromPath, localize, t } from '../i18n';

interface Props {
  project: Project;
  /** Id of the current sub-page, or undefined for the overview. */
  current?: string;
  pageTitle?: string;
  /** Serbian page whose body is still in English. */
  untranslated?: boolean;
}

const { project, current, pageTitle, untranslated = false } = Astro.props;
const { title, summary, layer, stack, team, context, status, repo, repos, playStore, demo, icon } = project.data;

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const P = T.project;
const all = (await getProjects(lang)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
const next = all[(all.findIndex((p) => p.id === project.id) + 1) % all.length];

const subs = await getSubpages(lang, project.id);
const tabs = [
  { href: localize(`/projects/${project.id}/`, lang), label: P.overview, id: undefined as string | undefined },
  ...subs.map((s) => ({ href: localize(`/projects/${s.id}/`, lang), label: s.data.tab, id: s.id })),
];

const facts: [string, string][] = [
  [P.facts.layer, `${T.layers[layer].name} (${LAYER_INFO[layer].addr})`],
  [P.facts.context, context],
  ...(team ? ([[P.facts.team, team]] as [string, string][]) : []),
  [P.facts.status, T.status[status]],
];
---

<Base
  title={`${pageTitle ? `${pageTitle} · ` : ''}${title} — ${SITE.name}`}
  description={summary}
  image={`/og/${project.id}.png`}
>
  <main class="site-wrap py-12 md-py-20">
    <a
      class="inline-flex items-center gap-2 font-mono text-10 uppercase tracking-16 text-white-45 transition-colors hover-text-accent"
      href={localize('/projects/', lang)}
    >
      <Icon name="arrow-left" class="icon-sm" />{P.allProjects}
    </a>

    <div data-reveal>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <span class="tag-accent">{P.layer(T.layers[layer].name)}</span>
        <span class="status" data-status={status}>{T.status[status]}</span>
      </div>
      <div class="mt-5 flex items-center gap-4">
        {icon && <Image class="app-icon" src={icon} alt="" width={128} height={128} format="webp" />}
        <h1
          class="max-w-3xl font-display text-h1 font-medium leading-105 tracking-tight"
          transition:name={`title-${project.id}`}
        >
          {title}
        </h1>
      </div>
      <p class="mt-5 max-w-2xl text-17 leading-relaxed text-white-70">{summary}</p>
      <ul class="mt-6 flex flex-wrap gap-1_5" aria-label={T.card.technologies}>
        {stack.map((s) => <li class="tech">{s}</li>)}
      </ul>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        {
          repo && (
            <a class="btn btn-line" href={repo} target="_blank" rel="noreferrer">
              {P.source} <Icon name="arrow-up-right" class="icon-sm" />
            </a>
          )
        }
        {
          repos.map((r) => (
            <a class="btn btn-ghost" href={r.url} target="_blank" rel="noreferrer">
              {r.label} <Icon name="arrow-up-right" class="icon-sm" />
            </a>
          ))
        }
        {
          playStore && (
            <a class="btn btn-solid" href={playStore} target="_blank" rel="noreferrer">
              {P.play} <Icon name="arrow-up-right" class="icon-sm" />
            </a>
          )
        }
        {
          demo && (
            <a class="btn btn-solid" href={demo} target="_blank" rel="noreferrer">
              {P.demo} <Icon name="arrow-up-right" class="icon-sm" />
            </a>
          )
        }
      </div>
    </div>

    {
      tabs.length > 1 && (
        <nav class="tabs mt-14" aria-label={P.pages(title)}>
          {tabs.map((t) => (
            <a href={t.href} aria-current={t.id === current ? 'page' : undefined}>
              {t.label}
            </a>
          ))}
        </nav>
      )
    }

    <div
      class:list={[
        'grid gap-10 pt-10 md-cols-250-1 md-gap-16',
        tabs.length > 1 ? 'mt-0' : 'mt-14 border-t border-white-10',
      ]}
    >
      <aside class="md-sticky md-top-24 md-self-start" data-reveal>
        <dl class="space-y-4">
          {
            facts.map(([k, v]) => (
              <div class="border-t border-white-10 pt-3">
                <dt class="font-mono text-10 uppercase tracking-18 text-white-35">{k}</dt>
                <dd class="mt-1_5 font-mono text-12_5 leading-relaxed text-f2">{v}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
      <div class="min-w-0">
        {untranslated && P.untranslated && <p class="untranslated" lang="sr-Latn">{P.untranslated}</p>}
        <slot />
      </div>
    </div>

    <a class="group mt-16 flex items-center justify-between gap-6 border-t border-white-10 pt-8" href={localize(`/projects/${next.id}/`, lang)}>
      <span>
        <span class="label">{P.next}</span>
        <span class="mt-2 block font-display text-next font-medium tracking-tight transition-colors group-hover-text-accent">
          {next.data.title}
        </span>
      </span>
      <Icon name="arrow-right" class="icon-md text-white-40 transition-all group-hover-nudge group-hover-text-ff4f00" />
    </a>
  </main>
</Base>
