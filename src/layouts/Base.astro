---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { SITE, NAV } from '../site';
import CvDialog from '../components/CvDialog.astro';
import { HTML_LANG, OG_LOCALE, langFromPath, localize, t, type Lang } from '../i18n';

// Version the site script by its content so a new deploy is never served from an old cache.
const scriptVersion = createHash('sha1')
  .update(readFileSync(join(process.cwd(), 'public/scripts/site.js')))
  .digest('hex')
  .slice(0, 10);

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image (Open Graph), a path under the site. */
  image?: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const other: Lang = lang === 'en' ? 'sr' : 'en';
const { title = T.siteTitle, description = T.siteDescription, image = '/og/site.png', noindex = false } = Astro.props;
const alternates = {
  en: new URL(localize(Astro.url.pathname, 'en'), Astro.site),
  sr: new URL(localize(Astro.url.pathname, 'sr'), Astro.site),
};
const otherPath = localize(Astro.url.pathname, other);
const ogImage = new URL(image, Astro.site);
// Tells search engines who the site belongs to and which profiles are the same person.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: Astro.site?.href,
  image: new URL('/images/vidan-stojic.jpg', Astro.site).href,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Belgrade', addressCountry: 'RS' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Union University, School of Computing (RAF)' },
  knowsAbout: ['Android', 'Kotlin', 'Jetpack Compose', 'Spring Boot', 'Compilers', 'Operating systems'],
  sameAs: [SITE.github, SITE.linkedin],
};
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isContact = path.startsWith(localize('/contact', lang));
const MOBILE_NAV = [
  { href: localize('/', lang), label: T.nav.home, match: localize('/', lang), exact: true },
  { href: localize('/projects/', lang), label: T.nav.projects, match: localize('/projects', lang), exact: false },
  { href: localize('/about/', lang), label: T.nav.about, match: localize('/about', lang), exact: false },
  { href: localize('/contact/', lang), label: T.nav.contact, match: localize('/contact', lang), exact: false },
];
const MAIN_NAV = NAV.map((n) => ({
  href: localize(n.href, lang),
  match: localize(n.match, lang),
  label: n.match === '/projects' ? T.nav.work : T.nav.about,
}));
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="sr" href={alternates.sr} />
          <link rel="alternate" hreflang="x-default" href={alternates.en} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="author" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      // Scroll animations hide content until JS reveals it. If the script ever fails
      // to load, drop the flag after 2.5 s so the page is still fully readable.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__vsReady) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="min-h-screen bg-0a">
      <header class="site-header sticky top-0 z-50 border-b border-white-10 bg-0a-90" transition:persist={`site-header-${lang}`}>
        <div class="site-wrap flex h-16 items-center justify-between gap-4">
          <a class="flex items-baseline gap-2_5" aria-label={T.homeLabel} href={localize('/', lang)}>
            <span class="font-mono text-13 tracking-tight text-f2">{SITE.name}</span>
            <span class="hidden sm-inline font-mono text-10 uppercase tracking-18 text-white-40">{T.role}</span>
          </a>
          <div class="header-actions">
          <nav class="site-nav flex items-center gap-5 sm-gap-7" aria-label={T.mainNav}>
            {
              MAIN_NAV.map((n) => {
                const active = path.startsWith(n.match);
                return (
                  <a class="nav-link" data-nav={n.match} aria-current={active ? 'page' : undefined} href={n.href}>
                    {n.label}
                  </a>
                );
              })
            }
            <a
              data-nav={localize('/contact', lang)}
              aria-current={isContact ? 'page' : undefined}
              class="nav-cta border border-accent-60 px-3 py-1_5 font-mono text-10 uppercase tracking-16 text-accent"
              href={localize('/contact/', lang)}>{T.nav.contact}</a
            >
          </nav>
          <a
            class="lang-switch"
            href={otherPath}
            hreflang={other}
            lang={HTML_LANG[other]}
            aria-label={T.langSwitchLabel}
            title={T.langSwitch}
            data-lang-switch={other}>{T.langSwitchShort}</a
          >
          <button
            class="menu-toggle"
            type="button"
            aria-label={T.menuOpen}
            data-label-open={T.menuOpen}
            data-label-close={T.menuClose}
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-menu-toggle
          >
            <span class="menu-toggle-bar"></span>
            <span class="menu-toggle-bar"></span>
            <span class="menu-toggle-bar"></span>
          </button>
          </div>
        </div>
        <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
          <nav class="mobile-menu-panel" aria-label={T.mobileNav}>
            <ul class="mobile-menu-links">
              {
                MOBILE_NAV.map((n, i) => (
                  <li style={`--i:${i}`}>
                    <a href={n.href} data-mnav={n.match} data-exact={n.exact ? '' : undefined} tabindex="-1">
                      <span class="mobile-menu-num">0{i + 1}</span>
                      {n.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="mobile-menu-foot" style={`--i:${MOBILE_NAV.length}`}>
              <p class="pill"><span class="hs7-dot" aria-hidden="true"></span>{T.availability}</p>
              <p class="mt-4 font-mono text-12_5 text-white-60">{SITE.email}</p>
            </div>
          </nav>
        </div>
      </header>

      <div transition:animate="fade">
        <slot />
      </div>

      <footer class="border-t border-white-10 bg-05 py-10">
        <div class="site-wrap flex flex-col gap-5 sm-flex-row sm-items-center sm-justify-between">
          <p class="font-mono text-11 uppercase tracking-16 text-white-55">
            © {new Date().getFullYear()} {SITE.name} · {T.location}
          </p>
          <div class="flex flex-wrap items-center gap-5 font-mono text-11 uppercase tracking-14">
            <a href={SITE.github} target="_blank" rel="noreferrer" class="link-line text-white-60 hover-text-f2">GitHub</a>
            {SITE.linkedin && <a href={SITE.linkedin} target="_blank" rel="noreferrer" class="link-line text-white-60 hover-text-f2">LinkedIn</a>}
            <a href={localize('/contact/', lang)} class="link-line text-white-60 hover-text-f2">{T.footer.contact}</a>
          </div>
        </div>
      </footer>
    </div>

    <CvDialog />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <div class="scroll-progress" aria-hidden="true" data-progress transition:persist></div>

    <script is:inline type="module" src={`/scripts/site.js?v=${scriptVersion}`}></script>
  </body>
</html>
