---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1b2130" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="home" href="/">{SITE.name}</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>© {new Date().getFullYear()} {SITE.name}. Built with Astro, hosted on GitHub Pages.</p>
      <p><a href="https://github.com/vidanstojic/vidanstojic.github.io">Source</a></p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .home {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--paper);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--paper);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 3rem;
    margin-top: 5rem;
    /* A rule as wide as the content, not the padded box. */
    background: linear-gradient(var(--rule), var(--rule)) no-repeat center top /
      calc(100% - 2 * var(--gutter)) 1px;
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
