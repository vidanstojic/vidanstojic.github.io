---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { SITE, NAV } from '../site';

// Version the site script by its content so a new deploy is never served from an old cache.
const scriptVersion = createHash('sha1')
  .update(readFileSync(join(process.cwd(), 'public/scripts/site.js')))
  .digest('hex')
  .slice(0, 10);

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isContact = path.startsWith('/contact');
const MOBILE_NAV = [
  { href: '/', label: 'Home', match: '/', exact: true },
  { href: '/projects/', label: 'Projects', match: '/projects', exact: false },
  { href: '/about/', label: 'About', match: '/about', exact: false },
  { href: '/contact/', label: 'Contact', match: '/contact', exact: false },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Scroll animations hide content until JS reveals it. If the script ever fails
      // to load, drop the flag after 2.5 s so the page is still fully readable.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__vsReady) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="min-h-screen bg-0a">
      <header class="site-header sticky top-0 z-50 border-b border-white-10 bg-0a-90" transition:persist>
        <div class="site-wrap flex h-16 items-center justify-between gap-4">
          <a class="flex items-baseline gap-2_5" aria-label={`${SITE.name}, home`} href="/">
            <span class="font-mono text-13 tracking-tight text-f2">{SITE.name}</span>
            <span class="hidden sm-inline font-mono text-10 uppercase tracking-18 text-white-40">{SITE.role}</span>
          </a>
          <nav class="site-nav flex items-center gap-5 sm-gap-7" aria-label="Main">
            {
              NAV.map((n) => {
                const active = path.startsWith(n.match);
                return (
                  <a class="nav-link" data-nav={n.match} aria-current={active ? 'page' : undefined} href={n.href}>
                    {n.label}
                  </a>
                );
              })
            }
            <a
              data-nav="/contact"
              aria-current={isContact ? 'page' : undefined}
              class="nav-cta border border-accent-60 px-3 py-1_5 font-mono text-10 uppercase tracking-16 text-accent"
              href="/contact/">Contact</a
            >
          </nav>
          <button
            class="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-menu-toggle
          >
            <span class="menu-toggle-bar"></span>
            <span class="menu-toggle-bar"></span>
            <span class="menu-toggle-bar"></span>
          </button>
        </div>
        <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
          <nav class="mobile-menu-panel" aria-label="Mobile">
            <ul class="mobile-menu-links">
              {
                MOBILE_NAV.map((n, i) => (
                  <li style={`--i:${i}`}>
                    <a href={n.href} data-mnav={n.match} data-exact={n.exact ? '' : undefined} tabindex="-1">
                      <span class="mobile-menu-num">0{i + 1}</span>
                      {n.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="mobile-menu-foot" style={`--i:${MOBILE_NAV.length}`}>
              <p class="pill"><span class="hs7-dot" aria-hidden="true"></span>{SITE.availability}</p>
              <p class="mt-4 font-mono text-12_5 text-white-60">{SITE.email}</p>
            </div>
          </nav>
        </div>
      </header>

      <div transition:animate="fade">
        <slot />
      </div>

      <footer class="border-t border-white-10 bg-05 py-10">
        <div class="site-wrap flex flex-col gap-5 sm-flex-row sm-items-center sm-justify-between">
          <p class="font-mono text-11 uppercase tracking-16 text-white-40">
            © {new Date().getFullYear()} {SITE.name} · {SITE.location}
          </p>
          <div class="flex flex-wrap items-center gap-5 font-mono text-11 uppercase tracking-14">
            <a href={SITE.github} target="_blank" rel="noreferrer" class="link-line text-white-60 hover-text-f2">GitHub</a>
            {SITE.linkedin && <a href={SITE.linkedin} target="_blank" rel="noreferrer" class="link-line text-white-60 hover-text-f2">LinkedIn</a>}
            <a href="/contact/" class="link-line text-white-60 hover-text-f2">Contact</a>
          </div>
        </div>
      </footer>
    </div>

    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <div class="scroll-progress" aria-hidden="true" data-progress transition:persist></div>

    <script is:inline type="module" src={`/scripts/site.js?v=${scriptVersion}`}></script>
  </body>
</html>
