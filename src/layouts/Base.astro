---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="min-h-screen bg-0a">
      <header class="sticky top-0 z-50 border-b border-white-10 bg-0a-90">
        <div class="site-wrap flex h-16 items-center justify-between gap-4">
          <a class="flex items-baseline gap-2_5" aria-label={`${SITE.name}, home`} href="/">
            <span class="font-mono text-13 tracking-tight text-f2">{SITE.name}</span>
            <span class="hidden sm-inline font-mono text-10 uppercase tracking-18 text-white-40">{SITE.role}</span>
          </a>
          <nav class="flex items-center gap-5 sm-gap-7" aria-label="Main">
            <a class="nav-link" data-status="active" href="/#work">Work</a>
            <a class="nav-link" data-status="active" href="/#about">About</a>
            <a
              class="border border-accent-60 px-3 py-1_5 font-mono text-10 uppercase tracking-16 text-accent transition-colors hover-bg-accent hover-text-0a"
              href="/#contact">Contact</a
            >
          </nav>
        </div>
      </header>

      <slot />

      <footer class="border-t border-white-10 bg-05 py-10">
        <div class="site-wrap flex flex-col gap-5 sm-flex-row sm-items-center sm-justify-between">
          <p class="font-mono text-11 uppercase tracking-16 text-white-40">
            © {new Date().getFullYear()} {SITE.name} · {SITE.location}
          </p>
          <div class="flex flex-wrap items-center gap-5 font-mono text-11 uppercase tracking-14">
            <a href={SITE.github} target="_blank" rel="noreferrer" class="link-line text-white-60 hover-text-f2">GitHub</a>
            {SITE.linkedin && <a href={SITE.linkedin} target="_blank" rel="noreferrer" class="link-line text-white-60 hover-text-f2">LinkedIn</a>}
            {SITE.email && <a href={`mailto:${SITE.email}`} class="link-line text-white-60 hover-text-f2">Email</a>}
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
