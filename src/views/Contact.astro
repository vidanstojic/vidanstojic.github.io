---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import { langFromPath, t } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const T = t(lang);
const C = T.contact;
---

<Base title={C.title} description={C.description}>
  <main class="site-wrap py-12 md-py-20">
    <div data-reveal>
      <span class="pill"><span class="hs7-dot" aria-hidden="true"></span>{T.availability}</span>
      <h1 class="mt-5 max-w-3xl font-display text-h1 font-medium leading-105 tracking-tight">{C.heading}</h1>
      <p class="mt-5 max-w-2xl text-17 leading-relaxed text-white-70">{C.lead}</p>
    </div>

    <div class="contact-grid mt-14 border-t border-white-10 pt-10">
      <div data-reveal>
        <form class="contact-form" data-contact-form data-key={SITE.web3formsKey} data-email={SITE.email} novalidate>
          <div class="grid gap-5 sm-grid-cols-2">
            <div class="field">
              <label for="f-name">{C.name}</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required />
              <p class="error" data-error="name"></p>
            </div>
            <div class="field">
              <label for="f-email">{C.email}</label>
              <input id="f-email" name="email" type="email" autocomplete="email" required />
              <p class="error" data-error="email"></p>
            </div>
          </div>
          <div class="field mt-5">
            <label for="f-topic">{C.topic}</label>
            <select id="f-topic" name="topic" required>
              <option value="" selected disabled>{C.chooseTopic}</option>
              {C.topics.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
            <p class="error" data-error="topic"></p>
          </div>
          <div class="field mt-5">
            <label for="f-message">{C.message}</label>
            <textarea id="f-message" name="message" required></textarea>
            <p class="error" data-error="message"></p>
          </div>
          <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <button class="btn btn-solid" type="submit"><span class="btn-label">{C.send}</span></button>
            <p class="text-12_5 text-white-55">{C.replyNote}</p>
          </div>
          <p class="form-privacy mt-5 max-w-xl text-12_5 leading-relaxed text-white-55">
            {C.privacyBefore}
            <a href="https://web3forms.com/privacy" target="_blank" rel="noreferrer">Web3Forms</a>
            {C.privacyAfter}
          </p>
        </form>

        <div class="success-box" data-form-success hidden>
          <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 12.5 9.5 18 20 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <h2 class="mt-4 font-display text-h3 font-medium tracking-tight">{C.sentTitle}</h2>
          <p class="mt-3 text-15 leading-relaxed text-white-70">{C.sentText}</p>
          <button class="btn btn-ghost mt-6" type="button" data-form-again>{C.again}</button>
        </div>
      </div>

      <aside class="space-y-4" data-stagger>
        <button class="contact-card" type="button" data-copy={SITE.email}>
          <span class="font-mono text-10 uppercase tracking-18 text-white-40">Email</span>
          <span class="font-mono text-13 text-f2">{SITE.email}</span>
          <span class="contact-action" data-copy-label>{C.copyEmail}</span>
        </button>
        {
          SITE.linkedin && (
            <a class="contact-card" href={SITE.linkedin} target="_blank" rel="noreferrer">
              <span class="font-mono text-10 uppercase tracking-18 text-white-40">LinkedIn</span>
              <span class="font-mono text-13 text-f2">{SITE.linkedinHandle}</span>
              <span class="contact-action">
                {C.openProfile} <Icon name="arrow-up-right" class="icon-sm" />
              </span>
            </a>
          )
        }
        <a class="contact-card" href={SITE.github} target="_blank" rel="noreferrer">
          <span class="font-mono text-10 uppercase tracking-18 text-white-40">GitHub</span>
          <span class="font-mono text-13 text-f2">{SITE.githubHandle}</span>
          <span class="contact-action">{C.browseCode} <Icon name="arrow-up-right" class="icon-sm" /></span>
        </a>
        <button class="contact-card" type="button" data-cv-open>
          <span class="font-mono text-10 uppercase tracking-18 text-white-40">CV</span>
          <span class="font-mono text-13 text-f2">{C.cvTitle}</span>
          <span class="contact-action">{C.cvAction}</span>
        </button>
        <p class="pt-3 font-mono text-11 uppercase tracking-14 text-white-40">{T.location}</p>
      </aside>
    </div>
  </main>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 4rem;
    }
  }
  .contact-card {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
    background: #0d0d0f;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1.1rem 1.25rem;
    transition: border-color 0.2s, background-color 0.2s;
  }
  @media (hover: hover) {
    .contact-card:hover {
      border-color: #ff4f00;
      background: rgba(255, 79, 0, 0.04);
      transform: translateY(-3px);
    }
    .contact-card:hover :global(svg) {
      transform: translate(2px, -2px);
    }
  }
  /* Touch: the same look while a finger is on the card (class set by site.js) */
  .contact-card:global(.is-touch-hover) {
    border-color: #ff4f00;
    background: rgba(255, 79, 0, 0.04);
    transform: translateY(-3px);
  }
  .contact-card:global(.is-touch-hover) :global(svg) {
    transform: translate(2px, -2px);
  }
  .contact-card {
    transition:
      border-color 0.3s,
      background-color 0.3s,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .contact-card :global(svg) {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .contact-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ff6a2b;
  }
  :global(.contact-card.is-copied) {
    border-color: #3ddc84;
  }
  :global(.contact-card.is-copied .contact-action) {
    color: #3ddc84;
  }
  /* Phones: labels at least 12px */
  @media (max-width: 767px) {
    .contact-action {
      font-size: 12px;
    }
  }
</style>
