---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { langFromPath } from '../i18n';

/**
 * Standalone app privacy policy pages (/privacy/<app>/), linked from the store
 * listings; Google Play needs a stable public URL. The text is the app's
 * "privacy" sub-page (src/content/subpages/<app>/privacy.md and its Serbian
 * translation), so the policy has one source and also shows as a project tab.
 */
const APPS = { 'draft-duel': 'Draft Duel' } as const;

interface Props {
  policy: keyof typeof APPS;
}
const lang = langFromPath(Astro.url.pathname);
const id = `${Astro.props.policy}/privacy`;
const entry = (lang === 'sr' && (await getEntry('subpagesSr', id))) || (await getEntry('subpages', id));
if (!entry) throw new Error(`Missing privacy sub-page ${id}`);
const { Content } = await render(entry);
const app = APPS[Astro.props.policy];
const label = lang === 'sr' ? 'Politika privatnosti' : 'Privacy policy';
---

<Base title={`${app} — ${label}`} description={entry.data.summary}>
  <main class="site-wrap py-20">
    <span class="tag-accent">{label}</span>
    <h1 class="mt-5 max-w-3xl font-display text-h1 font-medium leading-105 tracking-tight">{app}</h1>
    <div class="prose-tech mt-10 max-w-38">
      <Content />
    </div>
  </main>
</Base>
